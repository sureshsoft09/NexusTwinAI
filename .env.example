# NexusTwin AI - Local Google Cloud Vertex AI Configuration
# Project Name: NexusTwinAI-project | Project ID: nexustwinai-project
# Uses local gcloud ADC (`gcloud auth application-default set-quota-project nexustwinai-project`)

GOOGLE_CLOUD_PROJECT=nexustwinai-project
GCP_PROJECT_ID=nexustwinai-project
GOOGLE_CLOUD_LOCATION=us-central1
GCP_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini 2.5 Model Pinning
ADK_MODEL=gemini-2.5-flash
MODEL_REASONING=gemini-2.5-pro
MODEL_FAST=gemini-2.5-flash

# FastMCP Server Endpoints (Streamable HTTP)
MCP_ERP_URL=http://127.0.0.1:8081/mcp
MCP_LOGISTICS_URL=http://127.0.0.1:8082/mcp
MCP_BIGQUERY_URL=http://127.0.0.1:8083/mcp

# Remote A2A HITL Agent Base URL (Port 8001)
A2A_APPROVAL_AGENT_BASE_URL=http://localhost:8001/a2a/human_in_loop

# 4-Rule Feasibility Gate Thresholds
AUTONOMY_THRESHOLD_USD=1000.0
MIN_STOCKOUT_RUNWAY_BUFFER_HOURS=4.0
