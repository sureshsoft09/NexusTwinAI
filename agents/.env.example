# NexusTwin AI — Google ADK Agents Configuration Template (Copy to agents/.env)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_LOCATION=global
AGENT_ENGINE_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

ADK_MODEL=gemini-3.5-flash
MODEL_REASONING=gemini-3.5-flash
MODEL_FAST=gemini-3.5-flash

MCP_ERP_URL=https://your-erp-inventory-mcp-url.a.run.app/mcp
MCP_LOGISTICS_URL=https://your-logistics-rates-mcp-url.a.run.app/mcp
MCP_BIGQUERY_URL=https://your-bigquery-telemetry-mcp-url.a.run.app/mcp

A2A_APPROVAL_AGENT_BASE_URL=http://localhost:8001/a2a/human_in_loop

AUTONOMY_THRESHOLD_USD=1000.0
MIN_STOCKOUT_RUNWAY_BUFFER_HOURS=4.0
